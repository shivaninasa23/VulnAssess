# Local secrets and environment files. Keep the template trackable.
.env
.env.*
!.env.example

# Python environments and generated bytecode.
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]

# Local databases and SQLite sidecar files.
instance/
*.db
*.sqlite
*.sqlite3
*.db-*
*.sqlite-*

# Test, coverage, type-checker, and linter caches.
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Logs and scratch files.
*.log
logs/
tmp/
temp/

# Generated reports. The checked-in sample is synthetic, clearly labeled,
# and referenced by the project documentation.
*.pdf
!sample-report.pdf

# Build outputs.
build/
dist/
*.egg-info/
